@model List<portfolio.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">My Projects</h1>
            <p class="text-muted mb-0">
                Explore the projects I created from my courses.
            </p>
        </div>

        <a asp-controller="Projects"
           asp-action="Create"
           class="btn btn-primary">
            + Add Project
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No projects available yet.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var project in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">

                        @if (project.Images != null &&
                             project.Images.Count > 0)
                        {
                            <img src="@project.Images[0].ImageUrl"
                                 class="card-img-top"
                                 alt="@project.ProjectTitle"
                                 style="height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height: 220px;">
                                <span class="text-muted">
                                    No image available
                                </span>
                            </div>
                        }

                        <div class="card-body">

                            <span class="badge bg-secondary mb-2">
                                @(project.Course?.CourseCode ?? "Course")
                            </span>

                            <h5 class="card-title fw-bold">
                                @project.ProjectTitle
                            </h5>

                            <p class="text-muted">
                                @(string.IsNullOrWhiteSpace(project.Description)
                                    ? "No description available."
                                    : project.Description)
                            </p>

                            <p class="small text-muted">
                                Images: @(project.Images?.Count ?? 0)
                            </p>

                        </div>

                        <div class="card-footer bg-white d-flex gap-2">

                            <a asp-controller="Projects"
                               asp-action="Details"
                               asp-route-id="@project.ProjectId"
                               class="btn btn-outline-primary btn-sm">
                                View
                            </a>

                            <a asp-controller="Projects"
                               asp-action="Edit"
                               asp-route-id="@project.ProjectId"
                               class="btn btn-outline-warning btn-sm">
                                Edit
                            </a>

                        </div>

                    </div>
                </div>
            }

        </div>
    }

</div>

@model portfolio.Models.Project

@{
    ViewData["Title"] = "Project Details";
}

<div class="container py-5">

    <!-- Back Button -->
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Back to Projects
        </a>
    </div>

    <!-- Project Information -->
    <div class="card shadow-sm mb-5">
        <div class="card-body p-4">

            <span class="badge bg-secondary mb-2">
                @(Model.Course?.CourseCode ?? "Course")
            </span>

            <h1 class="fw-bold">@Model.ProjectTitle</h1>

            <p class="text-muted">
                @(Model.Course?.CourseTitle ?? "Course information unavailable")
            </p>

            <hr />

            <h5 class="fw-bold">Project Description</h5>

            <p>
                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "No description available."
                    : Model.Description)
            </p>

        </div>
    </div>

    <!-- Project Images -->
    <div class="mb-5">

        <h3 class="fw-bold mb-3">Project Images</h3>

        @if (Model.Images == null || Model.Images.Count == 0)
        {
            <div class="alert alert-info">
                No images available for this project.
            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var image in Model.Images)
                {
                    <div class="col-md-6 col-lg-4">

                        <div class="card shadow-sm h-100">

                            <img src="@image.ImageUrl"
                                 class="card-img-top"
                                 alt="Project Image"
                                 loading="lazy"
                                 referrerpolicy="no-referrer"
                                 style="width: 100%; height: 250px; object-fit: contain; background: #f1f1f1;" />

                            <div class="card-body">
                                <p class="small text-muted mb-0">
                                    Image @(image.SortOrder + 1)
                                </p>
                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

    <!-- Project Video -->
    <div class="mb-5">

        <h3 class="fw-bold mb-3">Project Video</h3>

        @if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
        {
            <div class="card shadow-sm">
                <div class="card-body p-3">

                    <div class="ratio ratio-16x9">

                        <iframe src="@Model.VideoUrl"
                                title="@Model.ProjectTitle"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                referrerpolicy="strict-origin-when-cross-origin"
                                allowfullscreen>
                        </iframe>

                    </div>

                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                No video available for this project.
            </div>
        }

    </div>

    <!-- Action Buttons -->
    <div class="d-flex flex-wrap gap-2">

        <a asp-action="Edit"
           asp-route-id="@Model.ProjectId"
           class="btn btn-warning">
            Edit Project
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Projects
        </a>

    </div>

</div>

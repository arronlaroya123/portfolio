@model portfolio.Models.ProjectCreateViewModel

@{
    ViewData["Title"] = "Add Project";
}

<div class="container py-5">

    <h1 class="fw-bold mb-2">Add New Project</h1>
    <p class="text-muted mb-4">
        Add your project information, images, and video.
    </p>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CourseId" class="form-label">
                        Course
                    </label>

                    <select asp-for="CourseId"
                            asp-items="ViewBag.Courses"
                            class="form-select">
                        <option value="">-- Select Course --</option>
                    </select>

                    <span asp-validation-for="CourseId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProjectTitle" class="form-label">
                        Project Title
                    </label>

                    <input asp-for="ProjectTitle"
                           class="form-control"
                           placeholder="Enter project title" />

                    <span asp-validation-for="ProjectTitle"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Describe your project"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="VideoUrl" class="form-label">
                        Video URL
                    </label>

                    <input asp-for="VideoUrl"
                           class="form-control"
                           placeholder="https://..." />

                    <span asp-validation-for="VideoUrl"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrls" class="form-label">
                        Image URLs
                    </label>

                    <textarea asp-for="ImageUrls"
                              class="form-control"
                              rows="5"
                              placeholder="Enter one image URL per line"></textarea>

                    <div class="form-text">
                        Enter one image URL per line. At least one image is required.
                    </div>

                    <span asp-validation-for="ImageUrls"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Project
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

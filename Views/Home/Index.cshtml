@{
    ViewData["Title"] = "Home";
}

<section class="tech-hero">
    <div class="tech-hero-content">
        <p class="tech-label">
            WELCOME TO MY PERSONAL PORTFOLIO
        </p>

        <h1>
             I AM ARRON LAROYA
            <span>MULTIMEDIA ARTIST</span>
        </h1>

        <p class="tech-description">
            Welcome to my academic portfolio. Explore my
            creative projects, skills, courses, and experiences
            in multimedia.
        </p>

        <div class="tech-buttons">
            <a asp-controller="Projects"
               asp-action="Index"
               class="tech-btn">
                EXPLORE PROJECTS
                <span>↗</span>
            </a>

            <a asp-controller="Courses"
               asp-action="Index"
               class="tech-btn-outline">
                VIEW COURSES
            </a>
        </div>
    </div>


    <div class="tech-hero-visual">
        <div class="tech-circle">
            <div class="tech-circle-inner">
                <span>DESIGN</span>
                <strong>+</strong>
                <span>CREATIVITY</span>
            </div>
        </div>

        <div class="tech-orbit orbit-one"></div>
        <div class="tech-orbit orbit-two"></div>
    </div>
</section>

<section class="tech-section">
    <div class="tech-section-heading">
        <p class="tech-label">EXPLORE MY PORTFOLIO</p>
        <h2>WHAT YOU CAN <span>DISCOVER</span></h2>
    </div>

    <div class="tech-card-grid">
        <div class="tech-card">
            <span class="tech-card-number">01</span>
            <h3>MY COURSES</h3>
            <p>
                Discover the subjects and lessons
                that are part of my learning journey.
            </p>
            <a asp-controller="Courses" asp-action="Index">
                EXPLORE COURSES ↗
            </a>
        </div>

        <div class="tech-card">
            <span class="tech-card-number">02</span>
            <h3>MY PROJECTS</h3>
            <p>
                Explore my academic projects,
                creative works, and multimedia outputs.
            </p>
            <a asp-controller="Projects" asp-action="Index">
                VIEW PROJECTS ↗
            </a>
        </div>
    </div>
</section>

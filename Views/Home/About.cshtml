@{
    ViewData["Title"] = "About Me";
}

<section class="about-page">
    <div class="about-container">

        <div class="about-heading">
            <p class="tech-label">GET TO KNOW ME</p>
            <h1>ABOUT <span>ME.</span></h1>
            <p>
                A little introduction about who I am,
                what I do, and my creative journey.
            </p>
        </div>

        <div class="about-content">

            <div class="about-profile">
                <div class="about-profile-image">
                    <img src="~/images/profile.jpg" alt="My Profile Photo" />   
                </div>
            </div>

            <div class="about-information">
                <p class="tech-label">MY INTRODUCTION</p>

                <h2>Hello, I'm a Multimedia Student.</h2>

                <p>
                    I am a student passionate about multimedia,
                    creativity, and technology. I enjoy exploring
                    different ways to express ideas through
                    digital design and creative projects.
                </p>

                <p>
                    This portfolio showcases my academic journey,
                    skills, projects, and experiences as I continue
                    learning and improving my abilities.
                </p>

                <div class="about-details">
                    <div>
                        <span>COURSE</span>
                        <strong>Associate in Computer Technology</strong>
                    </div>

                    <div>
                        <span>SPECIALIZATION</span>
                        <strong>Multimedia Arts</strong>
                    </div>

                    <div>
                        <span>INTEREST</span>
                        <strong>Design and Digital Creativity</strong>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

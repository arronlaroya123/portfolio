
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - portfolio</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/portfolio.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg tech-navbar">
            <div class="container">
                <a class="navbar-brand tech-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-icon">P</span>
                    PORTFOLIO<span class="brand-dot">.</span>
                </a>

                <button class="navbar-toggler tech-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    
<ul class="navbar-nav ms-auto align-items-lg-center">
    <li class="nav-item">
        <a class="nav-link tech-nav-link"
           asp-controller="Home"
           asp-action="Index">
            Home
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link tech-nav-link"
           asp-controller="Home"
           asp-action="About">
            About Me
        </a>
    </li>

    @if (User.IsInRole("Editor"))
    {
        <li class="nav-item">
            <a class="nav-link tech-nav-link"
               asp-controller="Courses"
               asp-action="Index">
                Courses
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link tech-nav-link"
               asp-controller="Projects"
               asp-action="Index">
                Projects
            </a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link tech-nav-link"
               asp-controller="Projects"
               asp-action="Index">
                Courses
            </a>
        </li>
    }
</ul>

                    




                    <ul class="navbar-nav ms-lg-4 align-items-lg-center">
                        @if (User.IsInRole("Editor"))
                        {
                            <li class="nav-item">
                                <span class="editor-status">
                                    <span class="status-dot"></span>
                                    EDITOR MODE
                                </span>
                            </li>

                            <li class="nav-item ms-lg-3">
                                <form asp-controller="Editor"
                                      asp-action="SwitchToView"
                                      method="post"
                                      class="d-inline-flex">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="tech-editor-btn">
                                        SWITCH TO VIEW
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="tech-editor-btn"
                                   asp-controller="Editor"
                                   asp-action="Unlock">
                                    SWITCH TO EDITOR
                                </a>
                            </li>

                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="tech-main">
        @RenderBody()
    </main>

    <footer class="tech-footer">
        <div class="container">
            <div class="footer-content">
                <span>
                    © 2026 PORTFOLIO. ALL RIGHTS RESERVED.
                </span>

                <span class="footer-caption">
                    CREATIVITY • TECHNOLOGY • INNOVATION
                </span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
